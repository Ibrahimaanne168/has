# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Wave Checkout API (Sénégal - XOF)
# Obtenez vos clés depuis le portail Wave Business (Espace Développeur)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_BUSINESS_ID=
WAVE_COUNTRY=SN
WAVE_CURRENCY=XOF
WAVE_BASE_URL=https://api.wave.com

# URLs de redirection et URL publique de l'application
NEXT_PUBLIC_APP_URL=https://www.has-academie.online
WAVE_SUCCESS_URL=https://www.has-academie.online/payment/success
WAVE_CANCEL_URL=https://www.has-academie.online/payment/cancel

# Montant des frais d'inscription (en XOF)
INSCRIPTION_FEE_AMOUNT=25000

# Notifications Telegram Administrateur (Nouvelles inscriptions)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
