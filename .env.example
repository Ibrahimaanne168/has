# ============================================================
# Variables d'Environnement — Plateforme HAS
# ============================================================

# Clé secrète de session Flask
SECRET_KEY=votre_cle_secrete_super_securisee

# ------------------------------------------------------------
# 1. Base de données Neon (Serverless PostgreSQL) ou Supabase
# ------------------------------------------------------------
# Copiez l'URL de connexion depuis votre console Neon (Dashboard -> Connection Details -> Connection String)
# Exemple Neon : postgresql://neondb_owner:votre_mot_de_passe@ep-bold-waterfall-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:votre_mot_de_passe@ep-votre-endpoint.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------
# 2. Stockage Cloud Permanent (Optionnel si vous utilisez Supabase Storage / Cloudinary pour les fichiers)
# ------------------------------------------------------------
SUPABASE_URL=https://votre_projet.supabase.co
SUPABASE_KEY=votre_cle_anon_ou_service_role
SUPABASE_BUCKET=has-storage

# ------------------------------------------------------------
# 3. Configuration Email (Optionnel - Réinitialisation mot de passe)
# ------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application

# ------------------------------------------------------------
# 4. Fallback Local MySQL (Uniquement si DATABASE_URL n'est pas renseigné)
# ------------------------------------------------------------
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=
# MYSQLDATABASE=has_platform
