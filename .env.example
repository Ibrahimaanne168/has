# ============================================================
# Variables d'Environnement — Plateforme HAS
# ============================================================

# Clé secrète de session Flask
SECRET_KEY=votre_cle_secrete_super_securisee

# ------------------------------------------------------------
# 1. Base de données Supabase (PostgreSQL)
# ------------------------------------------------------------
# Copiez l'URL de connexion "URI" (Transaction pooler ou Direct) depuis les paramètres de votre projet Supabase (Database -> Connection String -> URI)
# Exemple : postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.votre_ref:votre_mot_de_passe@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------
# 2. Stockage Cloud Supabase Storage (Bucket Permanent)
# ------------------------------------------------------------
# Vos clés d'API Supabase (Project Settings -> API)
SUPABASE_URL=https://votre_projet.supabase.co
SUPABASE_KEY=votre_cle_anon_ou_service_role
SUPABASE_BUCKET=has-storage

# ------------------------------------------------------------
# 3. Configuration Email (Optionnel - Réinitialisation mot de passe)
# ------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application

# ------------------------------------------------------------
# 4. Fallback Local MySQL (Uniquement si DATABASE_URL n'est pas renseigné)
# ------------------------------------------------------------
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=
# MYSQLDATABASE=has_platform
